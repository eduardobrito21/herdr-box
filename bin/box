#!/usr/bin/env bash
set -euo pipefail

source_path=${BASH_SOURCE[0]}
while [[ -L "$source_path" ]]; do
  source_dir=$(cd -P "$(dirname "$source_path")" && pwd)
  link=$(readlink "$source_path")
  [[ $link = /* ]] && source_path=$link || source_path=$source_dir/$link
done
PLUGIN_ROOT=$(cd -P "$(dirname "$source_path")/.." && pwd)
source "$PLUGIN_ROOT/bin/lib/paths.sh"
node_bin=$(find_node)
export HERDR_BOX_LOCAL_CWD=${HERDR_BOX_LOCAL_CWD:-$PWD}
herdr_bin=${HERDR_BIN_PATH:-herdr}

# Standalone CLI and Herdr invocations use the same registered config/state.
if [[ -z ${HERDR_PLUGIN_CONFIG_DIR:-} ]]; then
  HERDR_PLUGIN_CONFIG_DIR=$("$herdr_bin" plugin config-dir herdr-box 2>/dev/null) || HERDR_PLUGIN_CONFIG_DIR=''
  [[ -z $HERDR_PLUGIN_CONFIG_DIR ]] || export HERDR_PLUGIN_CONFIG_DIR
fi
run_cli() { "$node_bin" "$PLUGIN_ROOT/dist/src/cli.js" "$@"; }
json_field() {
  "$node_bin" -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const x=JSON.parse(s);const v=process.argv[1].split(".").reduce((a,k)=>a?.[k],x);if(typeof v!=="string")throw Error("Missing string field: "+process.argv[1]);process.stdout.write(v);});' "$1"
}
quote_sh() { local s=$1; s=${s//\'/\'\\\'\'}; printf "'%s'" "$s"; }
require_devbox() {
  command -v devbox >/dev/null 2>&1 || { echo 'herdr-box: install the standalone Namespace devbox CLI: https://namespace.so/docs/devbox/cli (nsc devbox is not a substitute)' >&2; exit 1; }
}
open_pane() {
  local args=(plugin pane open --plugin herdr-box --entrypoint "$1" --placement zoomed)
  local pane_info target_pane error_file
  [[ -z ${HERDR_WORKSPACE_ID:-} ]] || args+=(--workspace "$HERDR_WORKSPACE_ID")
  target_pane=${HERDR_PANE_ID:-}
  if [[ -z $target_pane ]]; then
    pane_info=$("$herdr_bin" pane current --current)
    target_pane=$(printf '%s' "$pane_info" | json_field pane.pane_id)
  fi
  args+=(--target-pane "$target_pane" --no-focus)
  error_file=$(mktemp)
  if "$herdr_bin" "${args[@]}" 2>"$error_file"; then
    rm -f "$error_file"
    return 0
  fi
  if grep -q 'split and zoomed plugin panes target an existing pane; use target_pane_id' "$error_file"; then
    # Herdr 0.9.1 CLI serializes --target-pane incorrectly for zoomed panes.
    args=(plugin pane open --plugin herdr-box --entrypoint "$1" --placement tab)
    [[ -z ${HERDR_WORKSPACE_ID:-} ]] || args+=(--workspace "$HERDR_WORKSPACE_ID")
    args+=(--no-focus)
    if "$herdr_bin" "${args[@]}"; then
      rm -f "$error_file"
      return 0
    fi
  else
    cat "$error_file" >&2
  fi
  rm -f "$error_file"
  return 1
}
usage() { echo 'usage: box [open|shell|status|list|kill [--yes]|logs]' >&2; exit 2; }
command_name=${1:-open}; [[ $# -eq 0 ]] || shift
case "$command_name" in
  open|shell)
    [[ $# -eq 0 ]] || usage
    require_devbox
    if [[ -z ${HERDR_PLUGIN_ENTRYPOINT_ID:-} ]]; then
      if [[ $command_name == open ]]; then open_pane box; else open_pane shell; fi
      exit 0
    fi
    # All slow provisioning runs inside the visible pane, never twice in an action.
    echo 'herdr-box: ensuring Namespace Devbox…' >&2
    config=$(run_cli config)
    box_info=$(run_cli ensure)
    pi_command=''
    if [[ $command_name == open ]]; then
      pi_command=$(printf '%s' "$config" | json_field pi.command)
      if [[ -n $pi_command ]]; then
        echo 'herdr-box: checking pi…' >&2
        run_cli ensure-pi >/dev/null
      fi
    fi
    name=$(printf '%s' "$box_info" | json_field devboxName)
    remote_path=$(printf '%s' "$box_info" | json_field remotePath)
    [[ -n $name && $remote_path = /* ]] || { echo 'herdr-box: invalid Devbox attach information' >&2; exit 1; }
    remote="cd -- $(quote_sh "$remote_path")"
    if [[ -n $pi_command ]]; then
      # pi.command is trusted, user-authored shell code, like a terminal startup command.
      remote+=" && exec bash -lc $(quote_sh "$pi_command")"
    else
      remote+=' && exec bash -l'
    fi
    echo "herdr-box: attaching to $name (exit leaves the Devbox running)" >&2
    exec devbox ssh --force_pty "$name" -- bash -lc "$remote"
    ;;
  kill)
    [[ $# -le 1 ]] || usage
    [[ $# -eq 0 || $1 == --yes || $1 == -y ]] || usage
    if [[ ${1:-} != --yes && ${1:-} != -y ]]; then
      [[ -t 0 ]] || { echo 'herdr-box: noninteractive kill requires --yes' >&2; exit 2; }
      config=$(run_cli config)
      name=$(printf '%s' "$config" | json_field devbox.name)
      printf 'Destroy Namespace Devbox %s? This deletes its remote data. [y/N] ' "$name" >&2
      read -r answer
      [[ $answer == y || $answer == Y ]] || { echo 'herdr-box: kill cancelled' >&2; exit 1; }
    fi
    run_cli kill
    ;;
  status|list)
    [[ $# -eq 0 ]] || usage
    run_cli "$command_name"
    ;;
  logs)
    [[ $# -eq 0 ]] || usage
    exec "$herdr_bin" plugin log list --plugin herdr-box
    ;;
  *) usage ;;
esac
